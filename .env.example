DATABASE_URL="postgresql://<user>:<password>@localhost:5433/reimbursement"
TEST_DATABASE_URL="postgresql://<user>:<password>@localhost:5433/reimbursement_test"
REIMBURSEMENT_GO_WRITER_SCOPES=""
REIMBURSEMENT_GO_WEB_URL=""
POSTGRES_DB_NAME="reimbursement"
POSTGRES_USER_NAME="reimbursement"
POSTGRES_PASSWORD="replace-with-a-local-password"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="reimbursement-private"
S3_ACCESS_KEY_ID="replace-with-minio-access-key"
S3_SECRET_ACCESS_KEY="replace-with-minio-secret"
MINIO_ROOT_USER="replace-with-minio-root-user"
MINIO_ROOT_PASSWORD="replace-with-minio-root-password"
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"
RECEIPT_EXTRACTION_PROVIDER="paddleocr"
OCR_SERVICE_URL="http://127.0.0.1:8000"
MODEL_PROVIDER="fixture"
# OpenAI-compatible 模型仅在显式配置 MODEL_PROVIDER="openai-compatible" 后启用。
# MODEL_BASE_URL="https://your-provider.example/v1"
# MODEL_NAME="your-model-name"
# MODEL_PROVIDER_API_KEY=""
# MODEL_TIMEOUT_MS="20000"
EMBEDDING_PROVIDER="fixture"
# bge-m3 uses the Docker-internal service. OpenAI-compatible providers require EMBEDDING_BASE_URL and may use EMBEDDING_PROVIDER_API_KEY.
# EMBEDDING_BASE_URL="http://embedding-service:8080"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIMENSIONS="1024"
# EMBEDDING_PROVIDER_API_KEY=""
# EMBEDDING_TIMEOUT_MS="20000"
RECEIPT_PROVIDER_API_KEY=""
SESSION_SECRET="replace-with-a-long-random-secret"
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_REDIRECT_URI="http://localhost:3000/api/auth/feishu/callback"
FEISHU_ADMIN_OPEN_IDS=""
FEISHU_FINANCE_REVIEWER_OPEN_IDS=""
FEISHU_BOT_ENABLED="false"
FEISHU_BOT_OPEN_ID=""
FEISHU_EVENT_DELIVERY="long_connection"
FEISHU_ALERT_WEBHOOK_URL=""
APP_PUBLIC_URL="http://localhost:3000"
# Set to go-api only after the reimbursement-api migration profile is healthy.
REIMBURSEMENT_AGENT_MODE="legacy"
REIMBURSEMENT_API_URL="http://reimbursement-api:8080"
REIMBURSEMENT_AGENT_SERVICE_KEY=""
REIMBURSEMENT_AUTH_HS256_SECRET=""
REIMBURSEMENT_AUTH_PROVISIONING_KEY=""
# Private JetStream endpoint used only by agent-event-worker in Go API mode.
NATS_URL="nats://nats:4222"
DEV_DEMO_EMPLOYEE_ID="demo-employee"
DEV_DEMO_EMPLOYEE_NAME="演示员工"
DEV_DEMO_FEISHU_OPEN_ID="demo-feishu-open-id"

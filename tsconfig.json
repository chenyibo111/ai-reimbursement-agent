{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "incremental": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "services/agent/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "prisma*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}

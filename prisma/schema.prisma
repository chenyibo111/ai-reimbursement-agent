generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClaimStatus {
  DRAFT
  PROCESSING
  NEEDS_INFORMATION
  AWAITING_CONFIRMATION
  SUBMITTED
}

enum FieldSource {
  EXTRACTED
  USER_ENTERED
  SYSTEM_CALCULATED
}

enum ReceiptStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  FAILED
}

enum EmployeeRole {
  EMPLOYEE
  FINANCE_REVIEWER
  ADMIN
}

enum AsyncJobKind {
  RECEIPT_EXTRACTION
  POLICY_SOURCE_SYNC
}

enum AsyncJobStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  REVIEW_REQUIRED
  SUCCEEDED
  CLOSED
}

enum ReceiptExtractionNotificationStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  SENT
  CLOSED
}

enum ReviewCaseKind {
  RECEIPT_OCR
  POLICY_SYNC
}

enum ReviewCaseStatus {
  OPEN
  CLAIMED
  RESOLVED
  CLOSED
}

enum ValidationSeverity {
  BLOCKING
  WARNING
}

enum AgentProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InboundChannelEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  RETRYABLE
}

enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PolicyRuleType {
  CLAIM_TOTAL_MAX
  CATEGORY_ITEM_MAX
  CATEGORY_ALLOWED
  CATEGORY_REQUIRED_FIELD
}

enum PolicySourceType {
  FEISHU_DOCX
  FEISHU_WIKI
}

enum PolicySnapshotStatus {
  STAGED
  ACTIVE
  ARCHIVED
}

enum AgentConversationKind {
  PRIVATE
  GROUP
}

enum AgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AgentMessageChannel {
  WEB
  FEISHU
}

enum ReimbursementIntakeStatus {
  COLLECTING
  READY_TO_SUBMIT
  SUBMITTED
  ABANDONED
}

model Employee {
  id                   String                @id
  displayName          String
  department           String?
  feishuUserId         String?               @unique
  role                 EmployeeRole          @default(EMPLOYEE)
  createdAt            DateTime              @default(now())
  claims               ClaimDraft[]
  feishuConversations  FeishuConversation[]
  agentConversations   AgentConversation[]
  reimbursementIntakes ReimbursementIntake[]
  assignedReviewCases  ReviewCase[]

  @@index([role])
}

model ClaimDraft {
  id                   String                @id @default(cuid())
  employeeId           String
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status               ClaimStatus           @default(DRAFT)
  purpose              String?
  version              Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  receipts             Receipt[]
  expenseItems         ExpenseItem[]
  clarifications       Clarification[]
  validationResults    ValidationResult[]
  submissions          SubmissionSnapshot[]
  auditEvents          AuditEvent[]
  agentProposals       AgentFieldProposal[]
  inboundEvents        InboundChannelEvent[]
  feishuConversations  FeishuConversation[]
  asyncJobs            AsyncJob[]
  reviewCases          ReviewCase[]
  receiptExtractionNotifications ReceiptExtractionNotification[]

  @@index([employeeId, status])
}

model Receipt {
  id                String        @id @default(cuid())
  claimId           String
  claim             ClaimDraft    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  objectKey         String        @unique
  originalFilename  String?
  contentHash       String
  mimeType          String
  status            ReceiptStatus @default(PENDING)
  receiptType       String?
  extractionPayload Json?
  extractionVersion String?
  createdAt         DateTime      @default(now())
  expenseItem       ExpenseItem?
  asyncJobs         AsyncJob[]
  reviewCases       ReviewCase[]
  receiptExtractionNotifications ReceiptExtractionNotification[]

  @@index([claimId, contentHash])
}

model ExpenseItem {
  id              String               @id @default(cuid())
  claimId         String
  claim           ClaimDraft           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  receiptId       String?              @unique
  receipt         Receipt?             @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  amountCents     Int
  amountSource    FieldSource
  issuedOn        DateTime?
  issuedOnSource  FieldSource?
  invoiceNumber   String?
  invoiceSource   FieldSource?
  expenseCategory String?
  participants    String?
  projectCode     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  agentProposals  AgentFieldProposal[]
}

model AgentFieldProposal {
  id            String              @id @default(cuid())
  claimId       String
  claim         ClaimDraft          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  expenseItemId String?
  expenseItem   ExpenseItem?        @relation(fields: [expenseItemId], references: [id], onDelete: SetNull)
  targetRef     String
  field         String
  value         Json
  reason        String
  claimVersion  Int
  status        AgentProposalStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([claimId, status])
  @@index([claimId, createdAt])
}

model Clarification {
  id         String     @id @default(cuid())
  claimId    String
  claim      ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  field      String
  prompt     String
  answer     String?
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())
}

model ValidationResult {
  id          String             @id @default(cuid())
  claimId     String
  claim       ClaimDraft         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  code        String
  severity    ValidationSeverity
  message     String
  ruleVersion String
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([claimId, severity])
}

model SubmissionSnapshot {
  id               String     @id @default(cuid())
  claimId          String
  claim            ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimVersion     Int
  submissionNumber String     @unique
  payload          Json
  submittedAt      DateTime   @default(now())
}

model AuditEvent {
  id        String     @id @default(cuid())
  claimId   String
  claim     ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actorId   String
  type      String
  payload   Json
  createdAt DateTime   @default(now())

  @@index([claimId, createdAt])
}

model InboundChannelEvent {
  id               String                    @id @default(cuid())
  channel          String                    @default("FEISHU")
  eventId          String                    @unique
  messageId        String?                   @unique
  messageType      String
  chatId           String
  chatType         String                    @default("p2p")
  mentionedOpenIds String[]                  @default([])
  senderOpenId     String
  status           InboundChannelEventStatus @default(PENDING)
  failureCode      String?
  attemptCount     Int                       @default(0)
  claimId          String?
  claim            ClaimDraft?               @relation(fields: [claimId], references: [id], onDelete: SetNull)
  receivedAt       DateTime                  @default(now())
  processedAt      DateTime?
  updatedAt        DateTime                  @updatedAt

  @@index([status, receivedAt])
  @@index([chatId, senderOpenId])
}

model FeishuConversation {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  chatId       String
  claimId      String
  claim        ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  lastActiveAt DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([employeeId, chatId])
  @@index([claimId])
}

model AgentConversation {
  id                     String                @id @default(cuid())
  employeeId             String
  employee               Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scopeKey               String
  kind                   AgentConversationKind
  latestFeishuChatId     String?
  summary                String                @default("")
  summaryThroughSequence Int                   @default(0)
  nextSequence           Int                   @default(1)
  lastActiveAt           DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  messages               AgentMessage[]
  reimbursementIntakes   ReimbursementIntake[]
  receiptExtractionNotifications ReceiptExtractionNotification[]

  @@unique([employeeId, kind, scopeKey])
  @@index([employeeId, lastActiveAt])
}

model AgentMessage {
  id               String              @id @default(cuid())
  conversationId   String
  conversation     AgentConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sequence         Int
  role             AgentMessageRole
  channel          AgentMessageChannel
  channelMessageId String?             @unique
  inReplyToChannelMessageId String?    @unique
  text             String
  citations        Json?
  result           Json?
  createdAt        DateTime            @default(now())

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
}

// Agent-owned idempotency record. It intentionally stores only the tool result
// snapshot and no relation to reimbursement tables.
model AgentToolCall {
  toolCallId     String   @id
  conversationId String
  toolName       String
  result         Json
  completedAt    DateTime @default(now())

  @@index([conversationId, completedAt])
}

// Agent-owned at-least-once event-consumption ledger. It prevents a NATS
// redelivery from producing duplicate user-facing channel notifications.
model AgentProcessedEvent {
  eventId      String
  consumerName String
  processedAt  DateTime @default(now())

  @@id([eventId, consumerName])
  @@index([processedAt])
}

model ReimbursementIntake {
  id                     String                    @id @default(cuid())
  employeeId             String
  employee               Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status                 ReimbursementIntakeStatus @default(COLLECTING)
  claimId                String?
  conversationId         String
  conversation           AgentConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  collectedFields        Json                      @default("{}")
  pendingFields          String[]                  @default([])
  submissionToken        String?
  submissionPreview      Json?
  lastUserConfirmationAt DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([employeeId, status, updatedAt])
  @@index([conversationId, updatedAt])
  @@index([claimId])
}

model PolicyVersion {
  id                    String              @id @default(cuid())
  title                 String
  status                PolicyVersionStatus @default(DRAFT)
  version               Int                 @default(0)
  effectiveFrom         DateTime
  createdByEmployeeId   String
  publishedByEmployeeId String?
  publishedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  rules                 PolicyRule[]
  auditEvents           PolicyAuditEvent[]

  @@index([status, effectiveFrom])
}

model PolicyRule {
  id              String             @id @default(cuid())
  policyVersionId String
  policyVersion   PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  code            String
  name            String
  type            PolicyRuleType
  severity        ValidationSeverity
  config          Json
  enabled         Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([policyVersionId, code])
  @@index([policyVersionId, sortOrder])
}

model PolicyAuditEvent {
  id              String        @id @default(cuid())
  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  actorId         String
  type            String
  payload         Json
  createdAt       DateTime      @default(now())

  @@index([policyVersionId, createdAt])
}

model PolicySource {
  id                   String                   @id @default(cuid())
  type                 PolicySourceType
  canonicalUrl         String                   @unique
  resourceToken        String                   @unique
  title                String
  enabled              Boolean                  @default(true)
  createdByEmployeeId  String
  lastSuccessfulSyncAt DateTime?
  lastFailureCode      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  snapshots            PolicyDocumentSnapshot[]
  asyncJobs            AsyncJob[]
  reviewCases          ReviewCase[]

  @@index([enabled, updatedAt])
}

model AsyncJob {
  id             String         @id @default(cuid())
  kind           AsyncJobKind
  status         AsyncJobStatus @default(PENDING)
  claimId        String?
  claim          ClaimDraft?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  receiptId      String?
  receipt        Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  policySourceId String?
  policySource   PolicySource?  @relation(fields: [policySourceId], references: [id], onDelete: SetNull)
  attemptCount   Int            @default(0)
  maxAttempts    Int            @default(3)
  availableAt    DateTime       @default(now())
  leaseUntil     DateTime?
  failureCode    String?
  result         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reviewCases    ReviewCase[]
  receiptExtractionNotification ReceiptExtractionNotification?

  @@index([status, availableAt])
  @@index([receiptId])
  @@index([policySourceId])
}

model ReviewCase {
  id                 String           @id @default(cuid())
  kind               ReviewCaseKind
  status             ReviewCaseStatus @default(OPEN)
  jobId              String
  job                AsyncJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  claimId            String?
  claim              ClaimDraft?      @relation(fields: [claimId], references: [id], onDelete: SetNull)
  receiptId          String?
  receipt            Receipt?         @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  policySourceId     String?
  policySource       PolicySource?    @relation(fields: [policySourceId], references: [id], onDelete: SetNull)
  reasonCode         String
  assignedReviewerId String?
  assignedReviewer   Employee?        @relation(fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  resolution         Json?
  claimedAt          DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([kind, status, createdAt])
  @@index([assignedReviewerId, status])
}

model ReceiptExtractionNotification {
  id           String                            @id @default(cuid())
  jobId        String                            @unique
  job          AsyncJob                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  receiptId    String?
  receipt      Receipt?                          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  claimId      String?
  claim        ClaimDraft?                       @relation(fields: [claimId], references: [id], onDelete: SetNull)
  conversationId String
  conversation AgentConversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      AgentMessageChannel               @default(FEISHU)
  chatId       String
  status       ReceiptExtractionNotificationStatus @default(PENDING)
  attemptCount Int                               @default(0)
  maxAttempts  Int                               @default(3)
  availableAt  DateTime                          @default(now())
  leaseUntil   DateTime?
  failureCode  String?
  sentAt       DateTime?
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt

  @@index([status, availableAt])
  @@index([receiptId])
  @@index([claimId])
  @@index([conversationId])
}

model PolicyDocumentSnapshot {
  id             String               @id @default(cuid())
  sourceId       String
  source         PolicySource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status         PolicySnapshotStatus @default(STAGED)
  sourceRevision String
  contentHash    String
  title          String
  blocks         Json
  createdAt      DateTime             @default(now())
  activatedAt    DateTime?
  chunks         PolicyChunk[]

  @@unique([sourceId, sourceRevision])
  @@index([sourceId, status, createdAt])
}

model PolicyChunk {
  id           String                       @id @default(cuid())
  snapshotId   String
  snapshot     PolicyDocumentSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  sequence     Int
  headingPath  String[]                     @default([])
  content      String
  sourceAnchor String?
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())

  @@unique([snapshotId, sequence])
  @@index([snapshotId, sequence])
}

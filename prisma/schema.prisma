generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClaimStatus {
  DRAFT
  PROCESSING
  NEEDS_INFORMATION
  AWAITING_CONFIRMATION
  SUBMITTED
}

enum FieldSource {
  EXTRACTED
  USER_ENTERED
  SYSTEM_CALCULATED
}

enum ReceiptStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  FAILED
}

enum ValidationSeverity {
  BLOCKING
  WARNING
}

enum AgentProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InboundChannelEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  RETRYABLE
}

model Employee {
  id                  String               @id
  displayName         String
  department          String?
  feishuUserId        String?              @unique
  createdAt           DateTime             @default(now())
  claims              ClaimDraft[]
  feishuConversations FeishuConversation[]
}

model ClaimDraft {
  id                String             @id @default(cuid())
  employeeId        String
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status            ClaimStatus        @default(DRAFT)
  purpose           String?
  version           Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  receipts          Receipt[]
  expenseItems      ExpenseItem[]
  clarifications    Clarification[]
  validationResults ValidationResult[]
  submissions       SubmissionSnapshot[]
  auditEvents       AuditEvent[]
  agentProposals    AgentFieldProposal[]
  inboundEvents     InboundChannelEvent[]
  feishuConversations FeishuConversation[]

  @@index([employeeId, status])
}

model Receipt {
  id                  String        @id @default(cuid())
  claimId             String
  claim               ClaimDraft    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  objectKey           String        @unique
  originalFilename    String?
  contentHash         String
  mimeType            String
  status              ReceiptStatus @default(PENDING)
  receiptType         String?
  extractionPayload   Json?
  extractionVersion   String?
  createdAt           DateTime      @default(now())
  expenseItem         ExpenseItem?

  @@index([claimId, contentHash])
}

model ExpenseItem {
  id                String      @id @default(cuid())
  claimId           String
  claim             ClaimDraft  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  receiptId         String?     @unique
  receipt           Receipt?    @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  amountCents       Int
  amountSource      FieldSource
  issuedOn          DateTime?
  issuedOnSource    FieldSource?
  invoiceNumber     String?
  invoiceSource     FieldSource?
  expenseCategory   String?
  participants      String?
  projectCode       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agentProposals    AgentFieldProposal[]
}

model AgentFieldProposal {
  id            String              @id @default(cuid())
  claimId       String
  claim         ClaimDraft          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  expenseItemId String?
  expenseItem   ExpenseItem?        @relation(fields: [expenseItemId], references: [id], onDelete: SetNull)
  targetRef     String
  field         String
  value         Json
  reason        String
  claimVersion  Int
  status        AgentProposalStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  @@index([claimId, status])
  @@index([claimId, createdAt])
}

model Clarification {
  id          String     @id @default(cuid())
  claimId     String
  claim       ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  field       String
  prompt      String
  answer      String?
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
}

model ValidationResult {
  id          String             @id @default(cuid())
  claimId     String
  claim       ClaimDraft         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  code        String
  severity    ValidationSeverity
  message     String
  ruleVersion String
  resolvedAt  DateTime?
  createdAt   DateTime           @default(now())

  @@index([claimId, severity])
}

model SubmissionSnapshot {
  id               String     @id @default(cuid())
  claimId          String
  claim            ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimVersion     Int
  submissionNumber String     @unique
  payload          Json
  submittedAt      DateTime   @default(now())
}

model AuditEvent {
  id        String     @id @default(cuid())
  claimId   String
  claim     ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actorId   String
  type      String
  payload   Json
  createdAt DateTime   @default(now())

  @@index([claimId, createdAt])
}

model InboundChannelEvent {
  id            String                    @id @default(cuid())
  channel       String                    @default("FEISHU")
  eventId       String                    @unique
  messageId     String?                   @unique
  messageType   String
  chatId        String
  senderOpenId  String
  status        InboundChannelEventStatus @default(PENDING)
  failureCode   String?
  claimId       String?
  claim         ClaimDraft?               @relation(fields: [claimId], references: [id], onDelete: SetNull)
  receivedAt    DateTime                  @default(now())
  processedAt   DateTime?
  updatedAt     DateTime                  @updatedAt

  @@index([status, receivedAt])
  @@index([chatId, senderOpenId])
}

model FeishuConversation {
  id             String     @id @default(cuid())
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  chatId         String
  claimId        String
  claim          ClaimDraft @relation(fields: [claimId], references: [id], onDelete: Cascade)
  lastActiveAt   DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([employeeId, chatId])
  @@index([claimId])
}

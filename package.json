{
  "name": "ai-reimbursement-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:test:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "feishu:worker": "tsx --env-file=.env.local src/worker/feishu-bot.ts",
    "feishu:worker:container": "tsx src/worker/feishu-bot.ts",
    "agent:events:worker:container": "tsx src/worker/agent-event-worker.ts",
    "job:worker": "tsx --env-file=.env.local src/worker/job-worker.ts",
    "job:worker:container": "tsx src/worker/job-worker.ts",
    "alert:relay:container": "tsx src/worker/alert-relay.ts",
    "policy:sync": "tsx --env-file=.env.local src/worker/policy-sync.ts",
    "roles:bootstrap": "tsx --env-file=.env.local src/worker/role-bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "next": "^15.5.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^7.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
